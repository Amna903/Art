# Copy this file to .env.local and fill in your Supabase project values.
# Same project/schema as the original app — find these in Supabase project settings > API.


NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= 

# Server-only — never prefix with NEXT_PUBLIC_, never send to the browser.
# Powers the "delete user" action in /admin (app/api/admin/users/[id]/route.ts),
# since deleting an auth.users row requires the Admin API, not the anon key.
# Also required for artwork originality checks (platform hash index + status writes).
# Find it in Supabase project settings > API > service_role (or "secret" key).
SUPABASE_SERVICE_ROLE_KEY= 

# Optional — public reverse-image search via SerpAPI Google Lens.
# Without this key, uploads are still checked against existing platform artworks;
# clear platform duplicates are blocked, uncertain platform matches go to admin review.
# Get a key at https://serpapi.com/
SERPAPI_API_KEY=

# Optional — used to ignore the platform's own host in web reverse-image matches.
NEXT_PUBLIC_SITE_URL=

# Sanity CMS — used for editable site content (currently: homepage hero
# image + headline). Create a free project at sanity.io, then find these in
# manage.sanity.io > your project > Settings > API.
# Add the schema in sanity/schemas/siteSettings.ts to your Studio project,
# then create one "Site Settings" document with your hero image.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
